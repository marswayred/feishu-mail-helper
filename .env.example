# demo 是明确标识的虚构数据；真实接入必须设为 feishu
APP_MODE=demo
PORT=3000
# 默认仅监听回环地址；容器部署按网络隔离要求设为 0.0.0.0
HOST=127.0.0.1
# npm run dev 时的浏览器地址；部署时设为实际 HTTPS 域名，不含路径或末尾斜杠
APP_ORIGIN=http://localhost:5173
NODE_ENV=development

# 以下仅供服务端使用；不要放入任何 VITE_ 前缀变量
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=
# 可选：进一步限制可使用本工具的 open_id，英文逗号分隔；空值表示该租户内可授权应用的用户
ALLOWED_OPEN_IDS=
# 仅当位于一个可信的反向代理之后时设置 1；勿随意启用
TRUST_PROXY=0
