  "narrative": {
    "northStar": "通讯录索引",
    "overview": "面向办公场景的轻量工具界面：深蓝页头建立应用识别，浅底与白色工作区承载输入和结果。视觉表达服从标准表单、标签切换、清单和明确反馈，不以装饰取代任务信息。",
    "keyCharacteristics": ["浅底、深蓝页头与蓝色主操作。", "紧凑清单、清晰分隔与单一结果出口。", "中文系统字体负责阅读，等宽字体仅用于工号和邮箱数据。", "成功、待确认和错误同时使用颜色与文字表达。"],
    "rules": [],
    "dos": ["Do 保持浅底深蓝办公方向和标准表单操作习惯。", "Do 用清晰文字区分演示、授权、查询、异常和复制状态。", "Do 将工号、邮箱数据与普通说明文字分开排版。", "Do 在更改颜色后检查真实相邻背景上的文本和焦点对比度。"],
    "donts": ["Don't 以个人邮箱或虚构结果掩盖企业邮箱缺失。", "Don't 将数据状态仅编码为颜色。", "Don't 为普通工作区叠加装饰性阴影或嵌套卡片。", "Don't 让长邮箱或移动端说明文字撑出容器。"]
